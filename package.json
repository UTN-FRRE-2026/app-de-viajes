{
  "name": "app-viajes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/kernel",
    "packages/contracts",
    "packages/platform",
    "services/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis rabbitmq",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:dispatch": "npm run dev -w @viajes/dispatch"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
