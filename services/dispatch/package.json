{
  "name": "@viajes/dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/servidor.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "test": "prisma generate && vitest run",
    "test:dominio": "vitest run tests/dominio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@viajes/contracts": "0.1.0",
    "@viajes/kernel": "0.1.0",
    "@viajes/platform": "0.1.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "jose": "6.2.13",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
