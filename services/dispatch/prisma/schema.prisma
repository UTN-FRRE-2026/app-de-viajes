// Esquema de dispatch. Los estados son `text` con CHECK (agregado a mano en la migración)
// para que el SQL crudo de los locks no necesite casts de enums de Postgres.

generator client {
  provider               = "prisma-client"
  output                 = "../src/infra/db/generated"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model SolicitudViaje {
  id            String   @id @db.Uuid
  pasajeroId    String   @map("passenger_id") @db.Uuid
  estado        String   @map("status")
  origenLat     Float    @map("origin_lat")
  origenLng     Float    @map("origin_lng")
  destinoLat    Float    @map("destination_lat")
  destinoLng    Float    @map("destination_lng")
  choferId      String?  @map("driver_id") @db.Uuid
  motivoCancelacion String? @map("cancel_reason")
  version       Int      @default(0)
  creadaEn      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadaEn DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  ofertas    Oferta[]
  asignacion AsignacionActiva?

  @@index([pasajeroId])
  // Historial del chofer y panel del operador (más nuevos primero).
  @@index([choferId])
  @@index([estado, creadaEn])
  @@map("ride_requests")
}

model Oferta {
  id          String         @id @db.Uuid
  solicitudId String         @map("request_id") @db.Uuid
  choferId    String         @map("driver_id") @db.Uuid
  estado      String         @map("status")
  venceEn     DateTime       @map("expires_at") @db.Timestamptz(3)
  creadaEn    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  solicitud   SolicitudViaje @relation(fields: [solicitudId], references: [id])

  @@unique([solicitudId, choferId])
  @@index([estado, venceEn])
  @@map("offers")
}

// El "lock" del chofer: una fila por chofer con viaje activo. Lo garantiza la restricción única.
model AsignacionActiva {
  choferId    String         @id @map("driver_id") @db.Uuid
  solicitudId String         @unique @map("request_id") @db.Uuid
  creadaEn    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  solicitud   SolicitudViaje @relation(fields: [solicitudId], references: [id])

  @@map("driver_active_assignment")
}

model EventoOutbox {
  id          String    @id @db.Uuid
  tipo        String    @map("type")
  payload     Json
  requestId   String?   @map("request_id")
  creadoEn    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publicadoEn DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publicadoEn, creadoEn])
  @@map("outbox")
}

/// Idempotency-Key: se escribe en la misma transacción que el efecto.
model RegistroIdempotencia {
  alcance   String   @map("scope")
  clave     String   @map("key")
  huella    String   @map("request_hash") @db.Char(64)
  estado    Int      @map("status_code") @db.SmallInt
  respuesta Json     @map("response") @db.Json
  creadoEn  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([alcance, clave])
  @@index([creadoEn])
  @@map("idempotency_keys")
}

// Tarifa global versionada. Los CHECK (límites, una sola fila vigente, cadena del historial) están en
// la migración 20261122000000_tarifas. Se escribe con SQL en infra/db/tarifas-prisma.ts.
model TarifaVersion {
  version         Int      @id
  moneda          String   @default("ARS") @map("currency") @db.Char(3)
  bajadaCentavos  Int      @map("base_fare_cents")
  centavosPorKm   Int      @map("per_km_cents")
  centavosPorMin  Int      @map("per_minute_cents")
  minimoCentavos  Int      @map("minimum_cents")
  maxMetros       Int      @map("max_meters")
  creadaPor       String   @map("created_by")
  creadaEn        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vigente  TarifaVigenteFila?
  cambio   CambioTarifa?      @relation("cambio")
  siguiente CambioTarifa?     @relation("anterior")

  @@map("fare_versions")
}

model TarifaVigenteFila {
  id            Boolean       @id @default(true)
  version       Int           @unique
  actualizadaEn DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  tarifa        TarifaVersion @relation(fields: [version], references: [version])

  @@map("fare_current")
}

model CambioTarifa {
  version          Int            @id
  versionAnterior  Int?           @unique @map("previous_version")
  cambiadaPor      String         @map("changed_by")
  cambiadaEn       DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  valoresAnteriores Json?         @map("previous_values")
  valoresNuevos    Json           @map("new_values")
  requestId        String?        @map("request_id")
  tarifa           TarifaVersion  @relation("cambio", fields: [version], references: [version])
  anterior         TarifaVersion? @relation("anterior", fields: [versionAnterior], references: [version])

  @@map("fare_changes")
}
