// Esquema de dispatch. Los estados son `text` con CHECK (agregado a mano en la migración)
// para que el SQL crudo de los locks no necesite casts de enums de Postgres.

generator client {
  provider            = "prisma-client"
  output              = "../src/infra/db/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SolicitudViaje {
  id                String    @id @db.Uuid
  pasajeroId        String    @map("passenger_id") @db.Uuid
  estado            String    @map("status")
  origenLat         Float     @map("origin_lat")
  origenLng         Float     @map("origin_lng")
  destinoLat        Float     @map("destination_lat")
  destinoLng        Float     @map("destination_lng")
  choferId          String?   @map("driver_id") @db.Uuid
  motivoCancelacion String?   @map("cancel_reason")
  // Tarifa: la estimación al crear y la final al completar (CHECKs en la migración 20261123000000).
  // Importes en BigInt: una tarifa alta pasa el máximo de Int (migración 20261125000000).
  tarifaVersion     String?   @map("fare_version")
  estimadaCentavos  BigInt?   @map("estimated_fare_cents")
  estimadaMetros    Int?      @map("estimated_distance_m")
  estimadaSegundos  Int?      @map("estimated_duration_s")
  finalCentavos     BigInt?   @map("final_fare_cents")
  finalMetros       Int?      @map("final_distance_m")
  finalSegundos     Int?      @map("final_duration_s")
  motivosDiferencia String[]  @default([]) @map("fare_difference_reasons")
  iniciadoEn        DateTime? @map("started_at") @db.Timestamptz(3)
  // La zona del origen (al crear) y la flota del chofer (al aceptar). Migración 20261127000000_zonas.
  zonaId            String?   @map("zone_id") @db.Uuid
  flotaId           String?   @map("fleet_id") @db.Uuid
  version           Int       @default(0)
  creadaEn          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadaEn     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  ofertas    Oferta[]
  asignacion AsignacionActiva?
  cobro      Cobro?

  @@index([pasajeroId])
  // Historial del chofer y panel del operador (más nuevos primero).
  @@index([choferId])
  @@index([estado, creadaEn])
  // Reporte de la flota: sus viajes por estado en un período de inicio (migración 20261128000000).
  @@index([flotaId, estado, iniciadoEn])
  @@map("ride_requests")
}

model Oferta {
  id          String         @id @db.Uuid
  solicitudId String         @map("request_id") @db.Uuid
  choferId    String         @map("driver_id") @db.Uuid
  estado      String         @map("status")
  venceEn     DateTime       @map("expires_at") @db.Timestamptz(3)
  creadaEn    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  solicitud   SolicitudViaje @relation(fields: [solicitudId], references: [id])

  @@unique([solicitudId, choferId])
  @@index([estado, venceEn])
  @@map("offers")
}

// El "lock" del chofer: una fila por chofer con viaje activo. Lo garantiza la restricción única.
model AsignacionActiva {
  choferId    String         @id @map("driver_id") @db.Uuid
  solicitudId String         @unique @map("request_id") @db.Uuid
  creadaEn    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  solicitud   SolicitudViaje @relation(fields: [solicitudId], references: [id])

  @@map("driver_active_assignment")
}

model EventoOutbox {
  id            String    @id @db.Uuid
  tipo          String    @map("type")
  payload       Json
  requestId     String?   @map("request_id")
  creadoEn      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publicadoEn   DateTime? @map("published_at") @db.Timestamptz(3)
  // SSE: id del evento en el stream, y a quién se entrega (migración 20261124000000_tiempo_real).
  seq           BigInt    @unique @default(autoincrement())
  destinatarios String[]  @default([]) @map("recipients") @db.Uuid

  @@index([publicadoEn, creadoEn])
  @@map("outbox")
}

/// Idempotency-Key: se escribe en la misma transacción que el efecto.
model RegistroIdempotencia {
  alcance   String   @map("scope")
  clave     String   @map("key")
  huella    String   @map("request_hash") @db.Char(64)
  estado    Int      @map("status_code") @db.SmallInt
  respuesta Json     @map("response") @db.Json
  creadoEn  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([alcance, clave])
  @@index([creadoEn])
  @@map("idempotency_keys")
}

// Tarifa global versionada. Los CHECK (límites, una sola fila vigente, cadena del historial) están en
// la migración 20261122000000_tarifas. Se escribe con SQL en infra/db/tarifas-prisma.ts.
model TarifaVersion {
  version        Int      @id
  moneda         String   @default("ARS") @map("currency") @db.Char(3)
  bajadaCentavos Int      @map("base_fare_cents")
  centavosPorKm  Int      @map("per_km_cents")
  centavosPorMin Int      @map("per_minute_cents")
  minimoCentavos Int      @map("minimum_cents")
  maxMetros      Int      @map("max_meters")
  creadaPor      String   @map("created_by")
  creadaEn       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vigente   TarifaVigenteFila?
  cambio    CambioTarifa?      @relation("cambio")
  siguiente CambioTarifa?      @relation("anterior")

  @@map("fare_versions")
}

model TarifaVigenteFila {
  id            Boolean       @id @default(true)
  version       Int           @unique
  actualizadaEn DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  tarifa        TarifaVersion @relation(fields: [version], references: [version])

  @@map("fare_current")
}

model CambioTarifa {
  version           Int            @id
  versionAnterior   Int?           @unique @map("previous_version")
  cambiadaPor       String         @map("changed_by")
  cambiadaEn        DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  valoresAnteriores Json?          @map("previous_values")
  valoresNuevos     Json           @map("new_values")
  requestId         String?        @map("request_id")
  tarifa            TarifaVersion  @relation("cambio", fields: [version], references: [version])
  anterior          TarifaVersion? @relation("anterior", fields: [versionAnterior], references: [version])

  @@map("fare_changes")
}

/// Un cobro por viaje completado. El id es la clave de idempotencia con el proveedor de pagos.
model Cobro {
  id               String         @id @db.Uuid
  solicitudId      String         @unique @map("request_id") @db.Uuid
  pasajeroId       String         @map("passenger_id") @db.Uuid
  montoCentavos    BigInt         @map("amount_cents")
  moneda           String         @default("ARS") @map("currency") @db.Char(3)
  estado           String         @default("PENDIENTE") @map("status")
  intentosFallidos Int            @default(0) @map("failed_attempts")
  ultimoError      String?        @map("last_error")
  referencia       String?        @map("provider_ref")
  motivoRechazo    String?        @map("decline_reason")
  creadoEn         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadoEn    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  solicitud        SolicitudViaje @relation(fields: [solicitudId], references: [id])

  // El barrido: los pendientes, primero los que hace más que no se intentan (cada fallo toca updated_at).
  @@index([estado, actualizadoEn])
  @@map("payments")
}

// Flotas (variante G). Los CHECK del cupo y de los estados del chofer están en la migración
// 20261126000000_flotas.
model Flota {
  id            String        @id @db.Uuid
  nombre        String        @map("name")
  maxActivos    Int           @map("max_active")
  activos       Int           @default(0) @map("active_count")
  creadaEn      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadaEn DateTime      @default(now()) @map("updated_at") @db.Timestamptz(3)
  choferes      ChoferFlota[]

  @@map("fleets")
}

model ChoferFlota {
  id            String   @id @db.Uuid
  flotaId       String   @map("fleet_id") @db.Uuid
  patente       String   @unique @map("vehicle_plate")
  marca         String   @map("vehicle_make")
  modelo        String   @map("vehicle_model")
  habilitado    Boolean  @default(false) @map("approved")
  activo        Boolean  @default(false) @map("active")
  disponible    Boolean  @default(false) @map("available")
  creadoEn      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadoEn DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  flota         Flota    @relation(fields: [flotaId], references: [id])

  @@index([flotaId])
  @@map("drivers")
}

// Zonas operativas en PostGIS (migración 20261127000000_zonas: el índice GIST y el CHECK de validez
// están ahí). `area` se lee y se escribe con SQL en infra/db/zonas-prisma.ts.
model Zona {
  id            String                                 @id @db.Uuid
  nombre        String                                 @map("name")
  area          Unsupported("geometry(Polygon, 4326)")
  creadaEn      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  actualizadaEn DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(3)
  flotas        FlotaZona[]

  @@map("zones")
}

model FlotaZona {
  flotaId String @map("fleet_id") @db.Uuid
  zonaId  String @map("zone_id") @db.Uuid
  zona    Zona   @relation(fields: [zonaId], references: [id])

  @@id([flotaId, zonaId])
  @@index([zonaId])
  @@map("fleet_zones")
}
