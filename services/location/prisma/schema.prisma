// Esquema de location. `pings` es el historial de las dos versiones de 6.6: la ingenua inserta un
// ping por pedido; la optimizada los escribe en lotes desde el stream de Redis.
// Los CHECK de rangos se agregan a mano en la migración.

generator client {
  provider               = "prisma-client"
  output                 = "../src/infra/db/generated"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model Ping {
  id           BigInt   @id @default(autoincrement())
  // El chofer es el `sub` del token de identity: sin FK, esa base es de otro servicio.
  choferId     String   @map("driver_id") @db.Uuid
  lat          Float
  lng          Float
  // Hora del servidor, no la del celular: así no se puede "rejuvenecer" una posición.
  registradoEn DateTime @map("recorded_at") @db.Timestamptz(3)
  // Solo la versión optimizada: id de la entrada del stream de Redis. Único, para que reescribir un
  // lote después de una caída no duplique filas. Nulo en las filas de la versión ingenua.
  streamId     String?  @unique @map("stream_id")
  // Retención por viaje: NULL = sin clasificar; true = de un viaje (30 días). Los sin viaje se borran a
  // las 24 h. El índice parcial (recorded_at, id) WHERE en_viaje IS NULL está en la migración 20261126000000.
  enViaje      Boolean? @map("en_viaje")

  // La búsqueda toma la última posición de cada chofer (DISTINCT ON).
  @@index([choferId, registradoEn(sort: Desc)])
  // La retención borra los vencidos en lotes, por (recorded_at, id) (migración 20261125000000).
  @@index([registradoEn, id])
  @@map("pings")
}
