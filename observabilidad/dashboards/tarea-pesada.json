            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (de, resultado) (rate(location_posiciones_publicadas_total{entorno=~\"$entorno\", servicio=\"location\"}[$__rate_interval]))",
          "legendFormat": "{{de}} {{resultado}}",
          "range": true
        }
      ]
    }
  ]
}
