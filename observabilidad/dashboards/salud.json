    {
      "type": "timeseries",
      "id": 6,
      "title": "Lag del event loop p99 (por ventana)",
      "description": "event_loop_lag_seconds: atraso de un temporizador cada 100 ms. Los buckets van de 1 ms a 2 s, así que el percentil es aproximado (interpolado dentro del bucket).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (servicio, le) (rate(event_loop_lag_seconds_bucket{entorno=~\"$entorno\", servicio=~\"$servicio\"}[$__rate_interval])))",
          "legendFormat": "{{servicio}} p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (servicio, le) (rate(event_loop_lag_seconds_bucket{entorno=~\"$entorno\", servicio=~\"$servicio\"}[$__rate_interval])))",
          "legendFormat": "{{servicio}} p50",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Lag del event loop promedio y máximo desde el arranque",
      "description": "El máximo (event_loop_lag_max_ms) es desde que arrancó el proceso: no baja hasta reiniciarlo.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
