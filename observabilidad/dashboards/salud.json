            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum by (servicio) (rate(event_loop_lag_seconds_sum{entorno=~\"$entorno\", servicio=~\"$servicio\"}[$__rate_interval])) / sum by (servicio) (rate(event_loop_lag_seconds_count{entorno=~\"$entorno\", servicio=~\"$servicio\"}[$__rate_interval]))",
          "legendFormat": "{{servicio}} promedio (ventana)",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "event_loop_lag_max_ms{entorno=~\"$entorno\", servicio=~\"$servicio\"} / 1000",
          "legendFormat": "{{servicio}} máximo desde el arranque",
          "range": true
        }
      ]
    },
