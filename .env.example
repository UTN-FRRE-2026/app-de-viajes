# Copiar a .env. Valores solo para desarrollo.

POSTGRES_PASSWORD=postgres_dev
# El 5432 del host suele estar ocupado: el Postgres del proyecto escucha en 5434.
POSTGRES_PUERTO_HOST=5434

# --- dispatch ---
DISPATCH_PERSISTENCIA=postgres
DATABASE_URL=postgresql://dispatch_svc:dispatch_dev@localhost:5434/dispatch
DATABASE_URL_TEST=postgresql://dispatch_svc:dispatch_dev@localhost:5434/dispatch_test
JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=viajes-identity
JWT_AUDIENCE=viajes
OFERTAS_SIMULTANEAS=3
OFERTA_TTL_SEGUNDOS=15
# Mientras no exista location: choferes (uuid) separados por coma que se ofrecen a todas las solicitudes.
DISPATCH_CANDIDATOS_DEMO=00000000-0000-4000-8000-000000000002

# --- identity ---
IDENTITY_PERSISTENCIA=postgres
# Nombre propio y no DATABASE_URL: este archivo es compartido y esa variable apunta a dispatch.
IDENTITY_DATABASE_URL=postgresql://identity_svc:identity_dev@localhost:5434/identity
IDENTITY_DATABASE_URL_TEST=postgresql://identity_svc:identity_dev@localhost:5434/identity_test
REDIS_URL=redis://localhost:6379
# Base 15: los tests la vacían, así que no comparte datos con el resto.
REDIS_URL_TEST=redis://localhost:6379/15
# Clave privada RS256. La genera `npm run claves -w @viajes/identity`. No se versiona.
IDENTITY_JWT_CLAVE_PRIVADA_B64=
# Contraseña de los usuarios de prueba del seed. Solo desarrollo.
IDENTITY_SEED_CONTRASENA=solo-desarrollo-viajes-2026
JWT_TTL_SEGUNDOS=900
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACIONES=2
ARGON2_PARALELISMO=1
IDENTITY_LOGIN_MAX_POR_EMAIL=5
IDENTITY_LOGIN_MAX_POR_IP=30
IDENTITY_LOGIN_VENTANA_SEGUNDOS=900
