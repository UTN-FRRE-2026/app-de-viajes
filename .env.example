# Copiar a .env. Valores solo para desarrollo.

POSTGRES_PASSWORD=postgres_dev
# El 5432 del host suele estar ocupado: el Postgres del proyecto escucha en 5434.
POSTGRES_PUERTO_HOST=5434

# --- métricas (los tres servicios) ---
# Bearer de GET /metrics (lo usa Alloy para Grafana). SOLO DESARROLLO: en cualquier entorno publicado va
# uno aleatorio, distinto de LOCATION_TOKEN_SERVICIO. Al menos 32 caracteres.
METRICAS_TOKEN=solo-desarrollo-token-metricas-viajes-2026

# --- dispatch ---
DISPATCH_PERSISTENCIA=postgres
DATABASE_URL=postgresql://dispatch_svc:dispatch_dev@localhost:5434/dispatch
DATABASE_URL_TEST=postgresql://dispatch_svc:dispatch_dev@localhost:5434/dispatch_test
JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=viajes-identity
JWT_AUDIENCE=viajes
OFERTAS_SIMULTANEAS=3
OFERTA_TTL_SEGUNDOS=15
# Candidatos: `location` (GET /interno/candidatos, con el LOCATION_TOKEN_SERVICIO de la sección location)
# o `fijo` (la lista de DISPATCH_CANDIDATOS_DEMO, para una demo sin location).
DISPATCH_BUSCADOR=location
LOCATION_URL=http://localhost:3004
# Si location no contesta en este tiempo, la solicitud responde 503 y no se crea (falla cerrado).
LOCATION_TIMEOUT_MS=1000
DISPATCH_RADIO_BUSQUEDA_METROS=5000
# Solo con DISPATCH_BUSCADOR=fijo: choferes (uuid) separados por coma que se ofrecen a todas las solicitudes.
DISPATCH_CANDIDATOS_DEMO=00000000-0000-4000-8000-000000000002
# Idempotency-Key: dispatch usa REDIS_URL (sección identity) para el cerrojo de los pedidos en vuelo.
# Si el proceso se cae a mitad de un pedido, la clave queda tomada como mucho este tiempo.
IDEMPOTENCIA_EN_VUELO_SEGUNDOS=30
# Base 13: identity vacía la 15 y location usa la 14.
DISPATCH_REDIS_URL_TEST=redis://localhost:6379/13
# Tarifa (docs/tarifas.md), en centavos enteros. Los importes y el máximo los define el equipo:
# ESTOS SON DE EJEMPLO. Más adelante los configura el admin y estos quedan como semilla inicial.
TARIFA_BAJADA_CENTAVOS=150000
TARIFA_CENTAVOS_POR_KM=80000
TARIFA_CENTAVOS_POR_MINUTO=15000
TARIFA_MINIMO_CENTAVOS=250000
# Un recorrido más largo que esto no se estima (422 VIAJE_FUERA_DE_RANGO).
TARIFA_MAX_METROS=100000
# Mapas simulado: línea recta × desvío, a velocidad media constante (una aproximación, no un ruteo).
MAPAS_FACTOR_DESVIO=1.3
MAPAS_VELOCIDAD_KMH=25
# Si mapas no contesta en este tiempo, la estimación responde 503 (falla cerrado).
MAPAS_TIMEOUT_MS=1000
# Demora artificial del simulado, solo para demostrar el timeout. 0 en uso normal.
MAPAS_LATENCIA_SIMULADA_MS=0

# --- identity ---
IDENTITY_PERSISTENCIA=postgres
# Nombre propio y no DATABASE_URL: este archivo es compartido y esa variable apunta a dispatch.
IDENTITY_DATABASE_URL=postgresql://identity_svc:identity_dev@localhost:5434/identity
IDENTITY_DATABASE_URL_TEST=postgresql://identity_svc:identity_dev@localhost:5434/identity_test
REDIS_URL=redis://localhost:6379
# Base 15: los tests la vacían, así que no comparte datos con el resto.
REDIS_URL_TEST=redis://localhost:6379/15
# Clave privada RS256. La genera `npm run claves -w @viajes/identity`. No se versiona.
IDENTITY_JWT_CLAVE_PRIVADA_B64=
# Contraseña de los usuarios de prueba del seed. Solo desarrollo.
IDENTITY_SEED_CONTRASENA=solo-desarrollo-viajes-2026
JWT_TTL_SEGUNDOS=900
# Vida del refresh token (7 días). Se renueva en cada rotación.
IDENTITY_REFRESH_TTL_SEGUNDOS=604800
ARGON2_MEMORIA_KIB=19456
ARGON2_ITERACIONES=2
ARGON2_PARALELISMO=1
IDENTITY_LOGIN_MAX_POR_EMAIL=5
IDENTITY_LOGIN_MAX_POR_IP=30
IDENTITY_LOGIN_VENTANA_SEGUNDOS=900

# --- location ---
# ingenua (Postgres, referencia) u optimizada (Redis GEO + historial en lotes). Ver docs/location.md.
UBICACION_ESTRATEGIA=ingenua
# Nombre propio y no DATABASE_URL: este archivo es compartido y esa variable apunta a dispatch.
LOCATION_DATABASE_URL=postgresql://location_svc:location_dev@localhost:5434/location
LOCATION_DATABASE_URL_TEST=postgresql://location_svc:location_dev@localhost:5434/location_test
# Secreto compartido con dispatch para /interno/*. SOLO DESARROLLO: en cualquier entorno publicado se
# reemplaza por uno aleatorio (por ejemplo, el resultado de `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
LOCATION_TOKEN_SERVICIO=solo-desarrollo-token-servicio-location-2026
# Una posición más vieja que esto es de un chofer que dejó de reportar.
UBICACION_VIGENCIA_SEGUNDOS=30
# Optimizada: usa REDIS_URL (sección identity) con este prefijo de claves.
LOCATION_REDIS_PREFIJO=location:
# Base 14: identity usa la 15 para sus tests y la vacía entera.
LOCATION_REDIS_URL_TEST=redis://localhost:6379/14
# Historial en lotes: tamaño del lote, espera de la lectura, tope de la cola y reclamo de pendientes.
LOCATION_HISTORIAL_LOTE=500
LOCATION_HISTORIAL_ESPERA_MS=1000
LOCATION_HISTORIAL_MAX=500000
LOCATION_HISTORIAL_RECLAMO_MS=30000
LOCATION_PURGA_INTERVALO_MS=10000
